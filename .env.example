# PE Value Creation OS - environment configuration (PVC-130).
#
# Dev-safe defaults. docker-compose.yml loads this file into the mcp, api and worker containers
# (and overrides DATABASE_URL to point at the compose `db` service). For local runs outside Docker:
#   cp .env.example .env   # .env is git-ignored; never commit real values
#
# Staging and production do NOT use this file: plain settings come from the ECS task definitions and
# secrets from AWS Secrets Manager (infra/terraform/modules/pvc/compute.tf, docs/deployment.md).
# Variables marked SECRET must stay empty here.
# Note: an empty value counts as "unset" for every variable below that is left uncommented.

# --- Runtime mode ------------------------------------------------------------------------------------------
# dev | staging | prod. Authentication is REQUIRED outside dev (the processes refuse to start without
# PVC_AUTH_ISSUER). dev also enables PVC_ALLOWED_COMPANIES / PVC_DEV_TOKENS shortcuts.
PVC_ENV=dev
PVC_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------------------------------------
# Application role (pvc_app, subject to row-level security). Unset -> in-memory repository (tests only).
# The password below is the local-only dev password from deploy/dev-role-passwords.sql.
DATABASE_URL=postgresql://pvc_app:pvc_app_dev@localhost:5432/pvc
# One-off tasks only (not read by the long-running services):
#   pvc db upgrade          -> PVC_MIGRATION_DATABASE_URL (schema owner role pvc_migrator)
#   pvc db bootstrap-roles  -> PVC_ADMIN_DATABASE_URL plus PVC_APP_DB_PASSWORD / PVC_RO_DB_PASSWORD /
#                              PVC_MIGRATOR_DB_PASSWORD (SECRETS)
# PVC_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc
# PVC_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc

# --- Evidence store ----------------------------------------------------------------------------------------
# S3 bucket with versioning, Object Lock (governance) and SSE-KMS. Empty -> local filesystem store under
# PVC_EVIDENCE_DIR (the image sets /app/var/evidence).
PVC_EVIDENCE_BUCKET=
# Customer-managed KMS key id or ARN for evidence objects. Empty -> the bucket's default encryption applies.
PVC_EVIDENCE_KMS_KEY_ID=
# Extra Host headers the MCP endpoint accepts besides the PVC_MCP_RESOURCE_URL host (comma-separated).
# PVC_MCP_ALLOWED_HOSTS=

# --- Authentication (OAuth 2.1 / JWT from the fund's identity provider) --------------------------------------
# All empty in dev (auth disabled). Required when PVC_ENV is staging or prod.
PVC_AUTH_ISSUER=
PVC_AUTH_AUDIENCE=
PVC_AUTH_JWKS_URL=
# Public URL of the MCP endpoint, advertised as OAuth protected-resource metadata.
PVC_MCP_RESOURCE_URL=http://localhost:8000/mcp
PVC_AUTH_REQUIRED_SCOPES=pvc.read

# --- Egress ------------------------------------------------------------------------------------------------
# Comma-separated extra hosts the application may call (api.anthropic.com is always allowed). "*.example.com"
# allows subdomains. Deployed environments also enforce this list in AWS Network Firewall.
PVC_EGRESS_ALLOWLIST=

# --- Model -------------------------------------------------------------------------------------------------
# rules (deterministic, no model calls) | model (Claude proposes scenario rates and narrative).
PVC_PROPOSER=rules
# Model id used when PVC_PROPOSER=model. Leave commented to use the application default.
# PVC_MODEL=
# SECRET. Only needed when PVC_PROPOSER=model.
ANTHROPIC_API_KEY=

# --- Data sources ------------------------------------------------------------------------------------------
# fixtures (synthetic companies baked into the image) | csv | warehouse | composite
PVC_SOURCE_ADAPTER=fixtures
# Companies the worker may act on (comma-separated). Empty in dev -> every fixture company.
PVC_WORKER_COMPANIES=

# --- Notifications and links -------------------------------------------------------------------------------
# Base URL of the approval UI, used in KPI digests and approval notifications.
PVC_PUBLIC_URL=http://localhost:8080
# SECRET. Incoming-webhook URL for digests and escalations. Empty -> notifications go to the local outbox.
PVC_NOTIFY_WEBHOOK_URL=

# --- Telemetry ---------------------------------------------------------------------------------------------
# OTLP/HTTP collector, for example http://localhost:4318. Empty -> no trace or metric export.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Policy ------------------------------------------------------------------------------------------------
# Path to an operating-policy TOML file. Leave commented to use the policy packaged with the application
# (an empty value would be treated as a path).
# PVC_POLICY_PATH=/app/config/policy.toml
