# PE Value Creation OS - environment configuration (PVC-130).
#
# Dev-safe defaults. docker-compose.yml loads this file into the mcp, api and worker containers
# (and overrides DATABASE_URL to point at the compose `db` service). For local runs outside Docker:
#   cp .env.example .env   # .env is git-ignored; never commit real values
#
# Staging and production do NOT use this file: plain settings come from the ECS task definitions and
# secrets from AWS Secrets Manager (infra/terraform/modules/pvc/compute.tf, docs/deployment.md).
# Variables marked SECRET must stay empty here.
# Note: an empty value counts as "unset" for every variable below that is left uncommented.

# --- Runtime mode ------------------------------------------------------------------------------------------
# dev | staging | prod. Authentication is REQUIRED outside dev (the processes refuse to start without
# PVC_AUTH_ISSUER). dev also enables PVC_ALLOWED_COMPANIES / PVC_DEV_TOKENS shortcuts.
PVC_ENV=dev
PVC_LOG_LEVEL=INFO
# Dev-only shortcuts (ignored unless PVC_ENV=dev):
# Company ids the unauthenticated dev principal may access (comma-separated). Empty -> none.
PVC_ALLOWED_COMPANIES=acme-healthy,beacon-pricing,cedar-churn,delta-broken
# Opaque dev tokens for the approval API, as JSON: {"<token>": {<claims>}}. An approver needs
# "pvc_roles": ["approver"], "pvc_principal_type": "human" and "scope": "pvc.read pvc.approve". Example:
# PVC_DEV_TOKENS={"dev-approver": {"sub": "human:me", "pvc_companies": ["beacon-pricing"], "pvc_roles": ["approver"], "pvc_principal_type": "human", "scope": "pvc.read pvc.approve"}}
PVC_DEV_TOKENS=

# --- Operator commands (pvc run / resume / status / recompute / offboard / audit-export) --------------------
# Operator identity recorded in the audit log (defaults to the OS user name) and the companies it may act on.
# Outside dev, PVC_OPERATOR_COMPANIES is required; in dev, empty means every fixture company.
# PVC_OPERATOR=jane.doe
PVC_OPERATOR_COMPANIES=
# Private intake API: exact environment named in a human processing grant.
# Empty disables source intake, finance decisions and source downloads (HTTP 503).
# Does not enable a pilot or expand existing token roles.
PVC_PROCESSING_ENVIRONMENT_ID=

# --- Database ----------------------------------------------------------------------------------------------
# Application role (pvc_app, subject to row-level security). Unset -> in-memory repository (tests only).
# The password below is the local-only dev password from deploy/dev-role-passwords.sql.
DATABASE_URL=postgresql://pvc_app:pvc_app_dev@localhost:5432/pvc
# One-off tasks only (not read by the long-running services):
#   pvc db upgrade          -> PVC_MIGRATION_DATABASE_URL (schema owner role pvc_migrator)
#   pvc db bootstrap-roles  -> PVC_ADMIN_DATABASE_URL plus PVC_APP_DB_PASSWORD / PVC_RO_DB_PASSWORD /
#                              PVC_MIGRATOR_DB_PASSWORD (SECRETS)
# PVC_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc
# PVC_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pvc
# Role passwords set by `pvc db bootstrap-roles` (SECRETS; sent to PostgreSQL as SCRAM verifiers):
# PVC_APP_DB_PASSWORD=  PVC_RO_DB_PASSWORD=  PVC_MIGRATOR_DB_PASSWORD=
# libpq also reads PGPASSWORD when the URL carries no password (how deployed tasks connect).
# Tests only: an admin URL on which the test user can create databases enables the PostgreSQL tests.
# PVC_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- Evidence store ----------------------------------------------------------------------------------------
# S3 bucket with versioning, Object Lock (governance) and SSE-KMS. Empty -> local filesystem store under
# PVC_EVIDENCE_DIR (the image sets /app/var/evidence).
PVC_EVIDENCE_BUCKET=
# Customer-managed KMS key id or ARN for evidence objects. Empty -> the bucket's default encryption applies.
PVC_EVIDENCE_KMS_KEY_ID=
# Filesystem evidence store root when no bucket is set (the image uses /app/var/evidence).
# PVC_EVIDENCE_DIR=var/evidence
# Extra Host headers the MCP endpoint accepts besides the PVC_MCP_RESOURCE_URL host (comma-separated).
# PVC_MCP_ALLOWED_HOSTS=

# --- Authentication (OAuth 2.1 / JWT from the fund's identity provider) --------------------------------------
# All empty in dev (auth disabled). Required when PVC_ENV is staging or prod.
PVC_AUTH_ISSUER=
PVC_AUTH_AUDIENCE=
PVC_AUTH_JWKS_URL=
# Static PEM public key instead of a JWKS endpoint (tests, air-gapped setups).
# PVC_AUTH_PUBLIC_KEY=
# Public URL of the MCP endpoint, advertised as OAuth protected-resource metadata.
PVC_MCP_RESOURCE_URL=http://localhost:8000/mcp
PVC_AUTH_REQUIRED_SCOPES=pvc.read
# Scopes: pvc.read (MCP access), pvc.write (MCP tools that change state), pvc.approve (approval decisions).
# Approval API: its own token audience (must differ from the MCP audience) and the approval UI client ids (azp)
# allowed to record decisions. Both are required outside dev.
PVC_API_AUDIENCE=
PVC_API_CLIENT_IDS=

# --- Egress ------------------------------------------------------------------------------------------------
# Comma-separated extra hosts the application may call (api.anthropic.com is always allowed). "*.example.com"
# allows subdomains. Deployed environments also enforce this list in AWS Network Firewall.
PVC_EGRESS_ALLOWLIST=

# --- Model -------------------------------------------------------------------------------------------------
# rules (deterministic, no model calls) | model (Claude proposes scenario rates and narrative).
PVC_PROPOSER=rules
# Model id used when PVC_PROPOSER=model. Leave commented to use the application default.
# PVC_MODEL=
# SECRET. Only needed when PVC_PROPOSER=model.
ANTHROPIC_API_KEY=

# --- Data sources ------------------------------------------------------------------------------------------
# fixtures (synthetic companies baked into the image) | csv | warehouse | composite
PVC_SOURCE_ADAPTER=fixtures
# fixtures: synthetic company root (the image sets /app/fixtures/companies).
# PVC_FIXTURE_ROOT=tests/fixtures/companies
# csv: directory of per-company CSV exports.
# PVC_CSV_ROOT=/data/exports
# warehouse: SQLAlchemy URL and schema holding the pvc_<dataset> views (SECRET if the URL carries credentials).
# PVC_WAREHOUSE_URL=
# PVC_WAREHOUSE_SCHEMA=pvc
# composite: per-company source configuration (docs/sources.example.toml).
# PVC_SOURCES_CONFIG=/app/config/sources.toml
# Companies the worker may act on (comma-separated). Empty in dev -> every fixture company.
PVC_WORKER_COMPANIES=

# --- Notifications and links -------------------------------------------------------------------------------
# Base URL of the approval UI, used in KPI digests and approval notifications.
PVC_PUBLIC_URL=http://localhost:8080
# SECRET. Incoming-webhook URL for digests and escalations. Empty -> notifications go to the local outbox.
PVC_NOTIFY_WEBHOOK_URL=
# Local notification outbox when no webhook is set (the image uses /app/var/outbox).
# PVC_OUTBOX_DIR=var/outbox

# --- Telemetry ---------------------------------------------------------------------------------------------
# OTLP/HTTP collector, for example http://localhost:4318. Empty -> no trace or metric export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Overrides the service name (pvc-mcp, pvc-api or pvc-worker) in traces and metrics.
# OTEL_SERVICE_NAME=

# --- Policy ------------------------------------------------------------------------------------------------
# Path to an operating-policy TOML file. Leave commented to use the policy packaged with the application
# (an empty value would be treated as a path).
# PVC_POLICY_PATH=/app/config/policy.toml

# --- Benchmarks and health checks --------------------------------------------------------------------------
# Peer dataset for get_benchmarks. Defaults to the packaged SYNTHETIC placeholder; point at a licensed dataset.
# PVC_BENCHMARK_PATH=
# Container health check override: URL and the accepted status ("200", or "<500").
# PVC_HEALTHCHECK_URL=
# PVC_HEALTHCHECK_EXPECT=200

# Optional local observability profile: export before docker compose --profile observability up.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# PVC_GRAFANA_PASSWORD=choose-a-local-password
# PVC_WORKER_HEARTBEAT_PATH=var/worker-heartbeat
