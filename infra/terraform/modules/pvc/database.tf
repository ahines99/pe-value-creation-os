# Managed PostgreSQL (PVC-132): encrypted with the data KMS key, TLS enforced, automated backups with
# point-in-time recovery, no public access, and three least-privilege roles (src/pe_value_os/db/roles.sql):
#   pvc_migrator  schema owner, used only by the migrate task
#   pvc_app       runtime role for mcp/api/worker, subject to row-level security
#   pvc_readonly  reporting and access reviews
# The master user is only used by the one-off bootstrap task; RDS generates and stores its password.

locals {
  db_major = split(".", var.db_engine_version)[0]
  db_name  = "pvc"

  # Role passwords generated by Terraform and stored write-only in Secrets Manager (never in state).
  db_roles = toset(["app", "readonly", "migrator"])

  # Connection URLs carry no password: libpq reads PGPASSWORD, injected from Secrets Manager.
  db_endpoint = "${aws_db_instance.this.address}:${aws_db_instance.this.port}"
  db_urls = {
    app      = "postgresql://pvc_app@${local.db_endpoint}/${local.db_name}?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem"
    migrator = "postgresql://pvc_migrator@${local.db_endpoint}/${local.db_name}?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem"
    admin    = "postgresql://${var.db_master_username}@${local.db_endpoint}/${local.db_name}?sslmode=verify-full&sslrootcert=/app/certs/rds-global-bundle.pem"
  }
}

resource "aws_security_group" "db" {
  name        = "${local.prefix}-db"
  description = "PostgreSQL from application tasks only"
  vpc_id      = aws_vpc.this.id
  tags        = merge(local.tags, { Name = "${local.prefix}-db" })
}

resource "aws_vpc_security_group_ingress_rule" "db_from_workloads" {
  for_each                     = local.workloads
  security_group_id            = aws_security_group.db.id
  description                  = "PostgreSQL from ${each.key}"
  ip_protocol                  = "tcp"
  from_port                    = 5432
  to_port                      = 5432
  referenced_security_group_id = aws_security_group.workload[each.key].id
}

resource "aws_db_subnet_group" "this" {
  name       = local.prefix
  subnet_ids = aws_subnet.db[*].id
  tags       = local.tags
}

resource "aws_db_parameter_group" "this" {
  name        = "${local.prefix}-postgres${local.db_major}"
  family      = "postgres${local.db_major}"
  description = "${local.prefix}: TLS required"

  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  parameter {
    name  = "ssl_min_protocol_version"
    value = "TLSv1.2"
  }

  parameter {
    name  = "password_encryption"
    value = "scram-sha-256"
  }

  # Schema changes are audited; statement text of ordinary queries is not logged (it may contain portco data).
  parameter {
    name  = "log_statement"
    value = "ddl"
  }

  tags = local.tags

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_db_instance" "this" {
  identifier     = local.prefix
  engine         = "postgres"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  db_name                       = local.db_name
  username                      = var.db_master_username
  manage_master_user_password   = true
  master_user_secret_kms_key_id = aws_kms_key.data.arn

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage
  storage_type          = "gp3"
  storage_encrypted     = true
  kms_key_id            = aws_kms_key.data.arn

  db_subnet_group_name   = aws_db_subnet_group.this.name
  vpc_security_group_ids = [aws_security_group.db.id]
  parameter_group_name   = aws_db_parameter_group.this.name
  publicly_accessible    = false
  multi_az               = var.db_multi_az
  ca_cert_identifier     = var.db_ca_cert_identifier

  # Automated backups + point-in-time recovery for the whole retention window.
  backup_retention_period  = var.db_backup_retention_days
  backup_window            = var.db_backup_window
  maintenance_window       = var.db_maintenance_window
  copy_tags_to_snapshot    = true
  delete_automated_backups = false

  deletion_protection       = var.deletion_protection
  skip_final_snapshot       = false
  final_snapshot_identifier = "${local.prefix}-final"

  auto_minor_version_upgrade      = true
  allow_major_version_upgrade     = false
  apply_immediately               = false
  enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]

  performance_insights_enabled          = true
  performance_insights_kms_key_id       = aws_kms_key.data.arn
  performance_insights_retention_period = 7

  tags = local.tags

  depends_on = [aws_cloudwatch_log_group.rds]
}

# ---- Role passwords ---------------------------------------------------------------------------------------
# Ephemeral: generated during apply, written to Secrets Manager write-only, never stored in state or plan.
ephemeral "random_password" "db_role" {
  for_each = local.db_roles
  length   = 40
  special  = false
}

resource "aws_secretsmanager_secret" "db_role" {
  for_each                = local.db_roles
  name                    = "${local.prefix}/db/pvc_${each.key}-password"
  description             = "Password of PostgreSQL role pvc_${each.key}; applied to the database by the bootstrap task"
  kms_key_id              = aws_kms_key.data.arn
  recovery_window_in_days = var.deletion_protection ? 30 : 7
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "db_role" {
  for_each                 = local.db_roles
  secret_id                = aws_secretsmanager_secret.db_role[each.key].id
  secret_string_wo         = ephemeral.random_password.db_role[each.key].result
  secret_string_wo_version = var.db_role_password_version
}
